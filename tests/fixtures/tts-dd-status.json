{"type":"regex","data":[{"comment":"상태창","in":"\\[DD_STATUS\\]\\s*TIME::(?<time>[^\\r\\n]*)\\s*[\\r\\n]+JET::(?<jet>[^\\r\\n]*)\\s*[\\r\\n]+BOGART::(?<bogart>[^\\r\\n]*)\\s*[\\r\\n]+MARSHAL::(?<marshal>[^\\r\\n]*)\\s*[\\r\\n]+LAG::(?<lag>[^\\r\\n]*)\\s*[\\r\\n]+MAX::(?<max>[^\\r\\n]*)\\s*[\\r\\n]+(?<username>[^\\r\\n:]+)::(?<userpoints>[^\\r\\n]*)\\s*[\\r\\n]+\\[/DD_STATUS\\]","out":"<style>.dd-status,.dd-status *{box-sizing:border-box;}.dd-status{position:relative;width:100%;max-width:520px;margin:18px auto;padding:16px 16px 12px;overflow:hidden;background:#07060d;border:2px solid #ff2dd8;border-radius:6px;color:#e9f6ff;font-family:\"Courier New\",Consolas,monospace;}.dd-row{position:relative;z-index:1;display:grid;grid-template-columns:76px 1fr 38px;align-items:center;gap:8px;margin-bottom:7px;}.dd-fill{height:100%;width:calc(var(--p) * 100% / 500);max-width:100%;background:var(--c);}.dd-status br{display:none;}.dd-line{display:block;}</style><div class=\"dd-status\"><div class=\"dd-header\"><div class=\"dd-title-wrap\"><div class=\"dd-tag\">ON AIR</div><div class=\"dd-title\"><span class=\"dd-line\">Magnificent &amp; Spectacular</span><span class=\"dd-line\">Digital Drama</span></div></div><div class=\"dd-clock\"><div class=\"dd-clock-label\"><span class=\"dd-dot\"></span>TIME</div><div class=\"dd-clock-value\">$1</div></div></div><div class=\"dd-label\">★ SUPERSTAR POINTS <span>// GOAL 500</span></div><div class=\"dd-row\" style=\"--c:#39ff88; --p:$2;\"><div class=\"dd-name\">JET</div><div class=\"dd-bar\"><div class=\"dd-fill\"></div></div><div class=\"dd-pts\">$2</div></div><div class=\"dd-row\" style=\"--c:#d4ff00; --p:$3;\"><div class=\"dd-name\">BOGART</div><div class=\"dd-bar\"><div class=\"dd-fill\"></div></div><div class=\"dd-pts\">$3</div></div><div class=\"dd-row\" style=\"--c:#00f0ff; --p:$4;\"><div class=\"dd-name\">MARSHAL</div><div class=\"dd-bar\"><div class=\"dd-fill\"></div></div><div class=\"dd-pts\">$4</div></div><div class=\"dd-row\" style=\"